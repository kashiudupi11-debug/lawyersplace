# Copy to .env and fill in. Never commit .env.

# ── Database (hosted Postgres: Neon / Supabase) ──
# Pooled connection used by the app at runtime
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"
# Direct (unpooled) connection used by `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# ── App ──
APP_URL="http://localhost:3000"
# 32+ random bytes, e.g. `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
AUTH_SECRET=""
CRON_SECRET=""
BACKUP_REPORT_SECRET=""

# ── Document storage ── ("local" for development, "s3" for production)
STORAGE_DRIVER="local"
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
MAX_UPLOAD_MB="25"

# ── AI (LegalDesk AI) ── leave empty to disable
ANTHROPIC_API_KEY=""
AI_MODEL="claude-sonnet-5-5"

# ── Email ── leave empty to show "Not configured"
RESEND_API_KEY=""
EMAIL_FROM=""

# ── SMS / WhatsApp (Twilio) ── leave empty to show "Not configured"
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_SMS_FROM=""
TWILIO_WHATSAPP_FROM=""

# ── Online payments (optional, Razorpay) ──
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# Demo accounts password (development only)
DEMO_PASSWORD=""
